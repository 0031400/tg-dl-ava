<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:tgdl.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="820"
        x:Class="tgdl.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/avalonia-logo.ico"
        Width="1240" Height="820" MinWidth="980" MinHeight="620"
        Title="tgdl — Telegram 文件下载器">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============================ 顶部工具栏 ============================ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="tgdl" Classes="h1" VerticalAlignment="Center" />
                    <Border Width="1" Height="22" Background="#E4E7EC" Margin="4,0" />
                    <TextBox Width="330" Height="34" VerticalContentAlignment="Center"
                             PlaceholderText="chat_id:message_id  例如 -1001234567890:42"
                             Text="{Binding NewTarget}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="加入队列" Command="{Binding AddCommand}" Classes="accent" Height="34" />
                    <Border Width="1" Height="22" Background="#E4E7EC" Margin="4,0" />
                    <Button Content="{Binding SessionButtonText}" Command="{Binding ToggleSessionCommand}"
                            Height="34" MinWidth="96" />
                    <Button Content="暂停队列" Command="{Binding PauseQueueCommand}" Height="34" />
                    <Button Content="继续队列" Command="{Binding ResumeQueueCommand}" Height="34" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding SessionBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SessionText}" Classes="dim" VerticalAlignment="Center"
                               MaxWidth="190" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="连接池状态：启动后按设置的 auth key 数量建立连接" />
                    <Border Width="1" Height="22" Background="#E4E7EC" Margin="6,0" />
                    <TextBlock Text="总速度" Classes="dim" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalSpeedText}" FontWeight="SemiBold" FontSize="14"
                               Foreground="#2563EB" VerticalAlignment="Center" MinWidth="90" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ 主体 ============================ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,430" Margin="12">

            <!-- 左：任务队列 -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="16,12" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="下载队列" Classes="h2" />
                                <TextBlock Text="{Binding QueueSummary}" Classes="dim" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开下载目录" Command="{Binding OpenDownloadFolderCommand}"
                                    Height="30" FontSize="12" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="8">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskItemViewModel">
                                        <Border Margin="4,4" Padding="12" CornerRadius="8"
                                                Background="#FAFBFC" BorderBrush="#E9ECF1" BorderThickness="1">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">

                                                <!-- 标题 + 状态 -->
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                                               Foreground="#111827" />
                                                    <Border Grid.Column="1" CornerRadius="9" Padding="8,2" Margin="8,0,0,0"
                                                            Background="#EEF4FF" BorderBrush="#C7DBFF" BorderThickness="1"
                                                            IsVisible="{Binding HasDc}"
                                                            ToolTip.Tip="文件所在的 DC，从消息里的 document/photo.dc_id 读出来">
                                                        <TextBlock Text="{Binding DcText}" FontSize="11"
                                                                   Foreground="#2563EB" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Grid.Column="2" CornerRadius="9" Padding="8,2" Margin="8,0,0,0"
                                                            Background="#F1F3F6">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                   Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>

                                                <!-- 元信息 -->
                                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Subtitle}" Classes="dim"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding WindowText}" Classes="dim" Foreground="#2563EB" />
                                                        <TextBlock Text="{Binding SpeedText}" Classes="dim" Foreground="#059669"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 进度条 -->
                                                <ProgressBar Grid.Row="2" Minimum="0" Maximum="1"
                                                             Value="{Binding ProgressValue}" Height="6"
                                                             Foreground="#2563EB" Background="#EDF0F4" />

                                                <!-- 操作按钮 -->
                                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding ErrorText}" Foreground="#DC2626" FontSize="11"
                                                               IsVisible="{Binding HasError}" TextWrapping="Wrap" MaxLines="2" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <Button Content="停止" FontSize="12" Height="26" Padding="10,0"
                                                                IsVisible="{Binding CanStop}"
                                                                Command="{Binding StopCommand}" />
                                                        <Button Content="继续" FontSize="12" Height="26" Padding="10,0"
                                                                IsVisible="{Binding CanResume}"
                                                                Command="{Binding ResumeCommand}" Classes="accent" />
                                                        <Button Content="打开" FontSize="12" Height="26" Padding="10,0"
                                                                IsVisible="{Binding IsDone}"
                                                                Command="{Binding OpenCommand}" />
                                                        <Button Content="定位" FontSize="12" Height="26" Padding="10,0"
                                                                IsVisible="{Binding HasFile}"
                                                                Command="{Binding RevealCommand}" />
                                                        <Button Content="删记录" FontSize="12" Height="26" Padding="10,0"
                                                                Command="{Binding DeleteRecordCommand}" />
                                                        <Button Content="删记录+文件" FontSize="12" Height="26" Padding="10,0"
                                                                IsVisible="{Binding HasFile}"
                                                                Foreground="#DC2626"
                                                                Command="{Binding DeleteWithFileCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                                        IsVisible="{Binding IsEmptyQueue}">
                                <TextBlock Text="队列是空的" HorizontalAlignment="Center" FontSize="15"
                                           Foreground="#9AA3AF" />
                                <TextBlock Text="把 chat_id:message_id 粘到上面的输入框，回车即可加入队列"
                                           HorizontalAlignment="Center" Classes="dim" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右：auth key / 设置 / 日志 -->
            <Border Grid.Column="1" Classes="card">
                <TabControl Padding="0" SelectedIndex="{Binding SelectedTab}">

                    <!-- = Auth Key = -->
                    <TabItem Header="Auth Key">
                        <ScrollViewer Padding="16">
                            <StackPanel Spacing="12">

                                <TextBlock TextWrapping="Wrap" Classes="dim"
                                           Text="auth key 就是授权凭据（等价于密码）。一条 key 对应一条独立 TCP 连接，Telegram 的限流按 key 计算，所以多条 key 并行能把额度摊开。" />

                                <Border Background="#F7F9FC" CornerRadius="8" Padding="12" BorderBrush="#E4E7EC"
                                        BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding AuthKeySummary}" Classes="h2" TextWrapping="Wrap" />
                                        <TextBlock Text="密钥文件：data/authkeys.json（可直接与 Python 版互拷）"
                                                   Classes="dim" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="导入 Key" Command="{Binding ToggleImportCommand}" Margin="0,0,8,8" />
                                    <Button Content="派生 Key" Command="{Binding ToggleDeriveCommand}" Margin="0,0,8,8" />
                                    <Button Content="同步会话列表" Command="{Binding SyncDialogsCommand}" Margin="0,0,8,8" />
                                    <Button Content="{Binding ClearKeysLabel}" Command="{Binding ClearKeysCommand}"
                                            Foreground="#DC2626" Margin="0,0,8,8" />
                                </WrapPanel>

                                <!-- 导入面板 -->
                                <Border IsVisible="{Binding ShowImport}" Background="#F7F9FC" CornerRadius="8"
                                        Padding="12" BorderBrush="#E4E7EC" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="导入 auth key" Classes="h2" />
                                        <TextBlock Classes="dim" TextWrapping="Wrap"
                                                   Text="粘贴 512 个 hex 字符（256 字节）的 auth key，并选择它属于哪个 DC。" />
                                        <TextBox Text="{Binding ImportHex}" Height="72" AcceptsReturn="True"
                                                 TextWrapping="Wrap" PlaceholderText="0123abcd…" FontFamily="Consolas" />
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto">
                                            <TextBlock Text="所属 DC" Classes="dim" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding ImportDcIndex}" Width="90">
                                                <ComboBoxItem>DC1</ComboBoxItem>
                                                <ComboBoxItem>DC2</ComboBoxItem>
                                                <ComboBoxItem>DC3</ComboBoxItem>
                                                <ComboBoxItem>DC4</ComboBoxItem>
                                                <ComboBoxItem>DC5</ComboBoxItem>
                                            </ComboBox>
                                            <CheckBox Grid.Column="2" Content="设为主 DC" IsChecked="{Binding ImportAsHome}"
                                                      Margin="12,0" />
                                            <Button Grid.Column="3" Content="导入" Classes="accent"
                                                    Command="{Binding ImportKeyCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 派生面板 -->
                                <Border IsVisible="{Binding ShowDerive}" Background="#F7F9FC" CornerRadius="8"
                                        Padding="12" BorderBrush="#E4E7EC" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="从主 key 派生新 key" Classes="h2" />
                                        <TextBlock Classes="dim" TextWrapping="Wrap"
                                                   Text="对目标 DC 做一次全新 DH 握手，再从主 DC 导出授权导入进去 —— 不需要重新登录，每条都是独立 key。注意：不能派生「主 DC 自己」的 key（Telegram 不允许导出本 DC 授权）。" />
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto">
                                            <TextBlock Text="目标 DC" Classes="dim" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding DeriveDcIndex}" Width="90">
                                                <ComboBoxItem>DC1</ComboBoxItem>
                                                <ComboBoxItem>DC2</ComboBoxItem>
                                                <ComboBoxItem>DC3</ComboBoxItem>
                                                <ComboBoxItem>DC4</ComboBoxItem>
                                                <ComboBoxItem>DC5</ComboBoxItem>
                                            </ComboBox>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0">
                                                <TextBlock Text="数量" Classes="dim" VerticalAlignment="Center" />
                                                <NumericUpDown Value="{Binding DeriveCount}" Minimum="1" Maximum="12"
                                                               Increment="1" Width="110" FormatString="0" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="开始派生" Classes="accent"
                                                    IsEnabled="{Binding CanDerive}"
                                                    Command="{Binding DeriveKeysCommand}" />
                                        </Grid>
                                        <TextBlock Text="{Binding DeriveHint}" Classes="dim" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- key 列表 -->
                                <ItemsControl ItemsSource="{Binding AuthKeyGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AuthKeyGroupViewModel">
                                            <Border Background="#F7F9FC" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                                    BorderBrush="#E4E7EC" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Header}" Classes="h2" />
                                                    <ItemsControl ItemsSource="{Binding Keys}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AuthKeyItemViewModel">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                                    <Border Background="#E7F0FF" CornerRadius="4" Padding="6,1"
                                                                            IsVisible="{Binding IsPrimary}">
                                                                        <TextBlock Text="主" FontSize="10" Foreground="#2563EB" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding ShortHex}"
                                                                               FontFamily="Consolas" FontSize="12"
                                                                               VerticalAlignment="Center" Margin="8,0"
                                                                               Foreground="#374151" />
                                                                    <Button Grid.Column="2" Content="删除" FontSize="11"
                                                                            Height="22" Padding="8,0"
                                                                            Command="{Binding RemoveCommand}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- = 设置 = -->
                    <TabItem Header="设置">
                        <ScrollViewer Padding="16">
                            <StackPanel Spacing="14">

                                <TextBlock Text="并发" Classes="h2" />
                                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <TextBlock Text="使用多少条 auth key" Classes="dim" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding Settings.AuthKeyCount}"
                                                   Minimum="1" Maximum="12" Increment="1" FormatString="0" />

                                    <TextBlock Grid.Row="1" Text="每条 key 的并发" Classes="dim" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                   Value="{Binding Settings.ConcurrencyPerKey}"
                                                   Minimum="1" Maximum="32" Increment="1" FormatString="0" />

                                    <TextBlock Grid.Row="2" Text="分片大小 (KiB)" Classes="dim" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Settings.ChunkKb}"
                                                   Minimum="16" Maximum="1024" Increment="64" FormatString="0" />
                                </Grid>
                                <TextBlock Text="{Binding Settings.Hint}" Classes="dim" Foreground="#2563EB" />

                                <CheckBox Content="撞到 FLOOD_WAIT 时自动降低该连接的并发（自适应）"
                                          IsChecked="{Binding Settings.AdaptiveFlood}" />
                                <CheckBox Content="下载完成后自动打开所在文件夹"
                                          IsChecked="{Binding Settings.OpenFolderWhenDone}" />

                                <Border Height="1" Background="#E4E7EC" />

                                <TextBlock Text="下载目录" Classes="h2" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding Settings.DownloadDir}"
                                             PlaceholderText="留空 = exe 同目录的 downloads 文件夹" />
                                    <Button Grid.Column="1" Content="打开" Margin="8,0,0,0"
                                            Command="{Binding BrowseDownloadDirCommand}" />
                                </Grid>

                                <Border Height="1" Background="#E4E7EC" />

                                <TextBlock Text="api_id / api_hash" Classes="h2" />
                                <TextBlock Classes="dim" TextWrapping="Wrap"
                                           Text="auth key 本身不绑定 api_id，但每条连接都要带一个有效的 api_id 做 initConnection。默认用 Telegram Desktop 的，一般不用改。" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="api_id" Classes="dim" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Settings.ApiId}" />
                                    <TextBlock Grid.Column="2" Text="api_hash" Classes="dim" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Text="{Binding Settings.ApiHash}" FontFamily="Consolas" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="保存设置" Classes="accent" Command="{Binding SaveSettingsCommand}" />
                                    <TextBlock Text="总并发建议 ≤ 32；超过之后 FLOOD_WAIT 会明显变多"
                                               Classes="dim" VerticalAlignment="Center" />
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- = 日志 = -->
                    <TabItem Header="日志">
                        <Grid RowDefinitions="Auto,*" Margin="12">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Text="运行日志" Classes="h2" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="清空" FontSize="12" Height="26"
                                        Command="{Binding ClearLogCommand}" />
                            </Grid>
                            <TextBox Grid.Row="1" Name="LogBox" Text="{Binding LogText}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                     FontSize="11.5" Background="#FBFCFD" BorderBrush="#E4E7EC"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ============================ 状态栏 ============================ -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusBar}" Classes="dim" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="dim" VerticalAlignment="Center"
                           Text="data 目录：exe\data   ·   authkeys.json / tasks.json / entities.json / settings.json" />
            </Grid>
        </Border>
    </Grid>
</Window>
